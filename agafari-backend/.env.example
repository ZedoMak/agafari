# Postgres with the pgvector extension available. The scheme may be plain
# postgresql://; the app names the psycopg driver itself.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

APP_NAME=Agafari API

# AI providers. Without a key the assistant still answers by quoting retrieved
# approved text, and retrieval falls back to keyword search.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADDIS_AI_API_KEY=
ADDIS_AI_BASE_URL=https://api.addisassistant.com/v1

# Retrieval and generation
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
CHUNK_SIZE=500
CHUNK_OVERLAP=100
LLM_MODEL=gpt-4o-mini

# Fallback access code for organizations with no stored code hash. Change it
# anywhere that is reachable from the internet.
DEMO_ACCESS_CODE=agafari-demo

# Local development builds missing tables on boot. Deployments run prestart.py
# and set this to false.
AUTO_CREATE_TABLES=true

# Origins beyond localhost and *.agafari.com, comma separated.
EXTRA_CORS_ORIGINS=
